# ==============================================================================
# SurakshaAI Web Application Environment Variables (Next.js)
# ==============================================================================

# API Base URL (SurakshaAI FastAPI Backend)
# For local development with FastAPI running: http://localhost:8000
# For production: https://api.yourdomain.com (leave empty for zero-downtime offline mode)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Authentication & Storage
# Obtain from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
