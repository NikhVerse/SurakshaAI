{
  "name": "surakshaai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SurakshaAI — Explainable Industrial Safety Critical-Risk Intelligence Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": ".\\.venv\\Scripts\\uvicorn apps.api.app.main:app --reload --port 8000",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "vercel-build": "npm --prefix apps/web run build",

    "test:api": ".\\.venv\\Scripts\\pytest apps/api/tests -v",
    "seed": ".\\.venv\\Scripts\\python data/demo/seed_data.py",
    "lint:api": ".\\.venv\\Scripts\\python -m pytest --collect-only"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "keywords": [
    "hse",
    "industrial-safety",
    "psif",
    "risk-intelligence",
    "explainable-ai",
    "ollama",
    "safety-barriers"
  ],
  "author": "SurakshaAI Engineering Team",
  "license": "Proprietary"
}
