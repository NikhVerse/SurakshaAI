APP_ENV=development
APP_NAME=SurakshaAI
APP_VERSION=1.0.0

# ==============================================================================
# Database Configuration — Supabase (PostgreSQL) Exclusively
# ==============================================================================
# Option 1: Supabase Direct Connection (Session Mode, port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option 2: Supabase Connection Pooler (Recommended for Vercel & Production, port 6543)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Project Credentials (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Frontend Supabase Public Variables (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Redis Configuration (Optional local background jobs)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Search
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_REPORTS=suraksha_reports
QDRANT_COLLECTION_KNOWLEDGE=suraksha_knowledge

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=suraksha-documents
STORAGE_LOCAL_DIR=./storage

# ==============================================================================
# Artificial Intelligence Engine — Exclusively OpenAI (GPT-4o)
# ==============================================================================
# Set your OpenAI API Key for live frontier intelligence.
# If left empty, SurakshaAI automatically operates in zero-downtime offline
# deterministic mode (local risk scoring, rules, & fallback reasoning).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Authentication & Security
JWT_SECRET=surakshaai_development_jwt_secret_key_production_389274982374
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=surakshaai_development_session_secret_key_847392817491
UPLOAD_MAX_MB=50

# Contact & Support Configuration
SUPPORT_EMAIL=hse-support@suraksha.ai
SECURITY_EMAIL=security@suraksha.ai
GENERAL_CONTACT_EMAIL=contact@suraksha.ai

# Frontend & Backend Ports
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
MLFLOW_TRACKING_URI=http://localhost:5000
