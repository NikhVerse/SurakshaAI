APP_ENV=development
APP_NAME=SurakshaAI
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL in production/Docker, SQLite default for zero-config local run)
DATABASE_URL=sqlite:///./surakshaai.db
# DATABASE_URL=postgresql://suraksha:suraksha_secure_pass@localhost:5432/suraksha_db

# Redis Configuration (Optional local background jobs)
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Search
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_REPORTS=suraksha_reports
QDRANT_COLLECTION_KNOWLEDGE=suraksha_knowledge

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=suraksha-documents
STORAGE_LOCAL_DIR=./storage

# Ollama Local Private AI Brain
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Authentication & Security
JWT_SECRET=surakshaai_development_jwt_secret_key_production_389274982374
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_SECRET=surakshaai_development_session_secret_key_847392817491
UPLOAD_MAX_MB=50

# Contact & Support Configuration
SUPPORT_EMAIL=hse-support@suraksha.ai
SECURITY_EMAIL=security@suraksha.ai
GENERAL_CONTACT_EMAIL=contact@suraksha.ai

# Frontend & Backend Ports
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
MLFLOW_TRACKING_URI=http://localhost:5000
